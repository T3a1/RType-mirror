# Doxygen configuration of the R-Type project: the documentation website, with
# the pages of docs/ and the code reference. `./rtype.py --docs` also generates
# the French pages of docs/fr/ under fr/, and adds the language button.
# Only the settings that differ from Doxygen's defaults are listed here.
# Run from the repository root: `doxygen` or `./rtype.py --docs`.

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "R-Type"
PROJECT_NUMBER         = 2.0
PROJECT_BRIEF          = "Networked multiplayer shoot'em up (C++20, ECS, UDP)"
OUTPUT_DIRECTORY       = build/docs
NUM_PROC_THREADS       = 0

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = README.md docs engine common server client
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.cpp *.md
USE_MDFILE_AS_MAINPAGE = README.md
EXCLUDE                = docs/fr
STRIP_FROM_INC_PATH    = engine/include common/include server/include client/include
BUILTIN_STL_SUPPORT    = YES
MARKDOWN_ID_STYLE      = GITHUB
IMAGE_PATH             = docs/images

#---------------------------------------------------------------------------
# Extraction (private members are not documented, see the doxygen skill)
#---------------------------------------------------------------------------
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO

#---------------------------------------------------------------------------
# Output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
GENERATE_TREEVIEW      = YES
HTML_COLORSTYLE        = AUTO_LIGHT
HTML_EXTRA_FILES       = tools/lang-switch.js
GENERATE_LATEX         = NO

#---------------------------------------------------------------------------
# Diagrams (Graphviz `dot` must be in the PATH; never set DOT_PATH here)
#---------------------------------------------------------------------------
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
